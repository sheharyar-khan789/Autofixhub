# Copy to .env.local (git-ignored). Names only: never commit real values.

# --- Public (safe for the browser; identifies the Firebase project) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the surrounding quotes; newlines are written as \n
FIREBASE_ADMIN_PRIVATE_KEY=
BUSINESS_ID=default
# Long random string, used to hash IP addresses for rate limiting.
# Only used by the dormant booking API: REQUIRED in production if WORKSHOP_FEATURES_ENABLED=true
# (the API returns 503 without it rather than falling back to a public salt).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Show clearly-marked placeholder sections until real content exists. Set to "false" at launch.
SHOW_PLACEHOLDERS=true

# Development/testing only. "memory" uses fictional in-memory fixtures and is refused in production.
# DATA_SOURCE=memory

# Dormant workshop features (public booking form + API, services catalogue, admin Bookings/Services/Reviews).
# AutoFixHub is a knowledge platform: leave unset/false. Only "true" switches them back on.
# WORKSHOP_FEATURES_ENABLED=false
